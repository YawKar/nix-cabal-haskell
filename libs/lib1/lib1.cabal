cabal-version: 3.12
name:          lib1
version:       0.1.0.0
license:       Unlicense
synopsis:      Example library 1
build-type:    Simple

-- NOTE: Please, if you update something here you should go and update other `*.cabal` files as well as this 'common' section was meant to be common for all packages in this template.
common common
  default-language: GHC2024

  default-extensions:
    -- different records can share a field like `rect`
    DuplicateRecordFields
    -- field names don't become top-level functions
    NoFieldSelectors
    -- update fields with optics labels (`player & #rect % #x .~ 10`)
    OverloadedLabels
    -- read fields with a dot (`player.rect.x`)
    OverloadedRecordDot

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies
    -Wredundant-constraints
    -Wunused-packages
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-import-lists
    -Wprepositive-qualified-module
    -fhide-source-paths
    -freverse-errors

  build-depends:    base >=4.20 && <5

library
  import:          common
  hs-source-dirs:  src
  exposed-modules: Lib1

test-suite lib1-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    , hspec  ^>=2.11
    , lib1

benchmark lib1-bench
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs

  ghc-options:
    -rtsopts
    -- Larger allocation area and aligned code, as tasty-bench recommends for stable timings.
    -with-rtsopts=-A32m
    -fproc-alignment=64
  build-depends:
    , lib1
    , tasty-bench  ^>=0.5
