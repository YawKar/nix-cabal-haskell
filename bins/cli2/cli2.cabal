cabal-version: 3.12
name:          cli2
version:       0.1.0.0
license:       Unlicense
synopsis:      Example executable 2
build-type:    Simple

common common
  default-language: GHC2024
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-deriving-strategies
    -Wredundant-constraints -Wunused-packages

  build-depends:    base >=4.20 && <5

executable cli2
  import:         common
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , lib1
    , lib2
